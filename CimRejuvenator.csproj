<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CimRejuvenator</AssemblyName>
    <RootNamespace>CimRejuvenator</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <Version>0.5.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Build modes:

    1) Official toolchain, when CSII_TOOLPATH is available and ForceNoUnityBuild is not true.
       Uses Mod.props / Mod.targets and the standard Cities: Skylines II code-modding pipeline.

    2) Direct-assembly fallback, when ForceNoUnityBuild=true or the toolchain is unavailable.
       References assemblies from the installed game. This works on Windows and Linux as long
       as the .NET SDK can access the game's Cities2_Data/Managed directory.
  -->
  <PropertyGroup>
    <CsiiToolPath>$(CSII_TOOLPATH)</CsiiToolPath>
    <CsiiToolPath Condition="'$(CsiiToolPath)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CsiiToolPath>
    <UseCsiiToolchain>false</UseCsiiToolchain>
    <UseCsiiToolchain Condition="'$(ForceNoUnityBuild)' != 'true' AND '$(CsiiToolPath)' != '' AND Exists('$(CsiiToolPath)/Mod.props') AND Exists('$(CsiiToolPath)/Mod.targets')">true</UseCsiiToolchain>
  </PropertyGroup>

  <Import Project="$(CsiiToolPath)/Mod.props" Condition="'$(UseCsiiToolchain)' == 'true'" />
  <Import Project="$(CsiiToolPath)/Mod.targets" Condition="'$(UseCsiiToolchain)' == 'true'" />

  <PropertyGroup Condition="'$(UseCsiiToolchain)' != 'true'">
    <CitiesSkylines2Path Condition="'$(CitiesSkylines2Path)' == ''">$(CSII_GAMEPATH)</CitiesSkylines2Path>

    <!-- Common Windows Steam locations. -->
    <CitiesSkylines2Path Condition="'$(CitiesSkylines2Path)' == '' AND Exists('C:/Program Files (x86)/Steam/steamapps/common/Cities Skylines II/Cities2_Data/Managed/Game.dll')">C:/Program Files (x86)/Steam/steamapps/common/Cities Skylines II</CitiesSkylines2Path>
    <CitiesSkylines2Path Condition="'$(CitiesSkylines2Path)' == '' AND Exists('C:/Program Files/Steam/steamapps/common/Cities Skylines II/Cities2_Data/Managed/Game.dll')">C:/Program Files/Steam/steamapps/common/Cities Skylines II</CitiesSkylines2Path>
    <CitiesSkylines2Path Condition="'$(CitiesSkylines2Path)' == '' AND Exists('D:/SteamLibrary/steamapps/common/Cities Skylines II/Cities2_Data/Managed/Game.dll')">D:/SteamLibrary/steamapps/common/Cities Skylines II</CitiesSkylines2Path>

    <!-- Common Linux Steam locations. The game itself runs through Proton. -->
    <CitiesSkylines2Path Condition="'$(CitiesSkylines2Path)' == '' AND Exists('$(HOME)/.local/share/Steam/steamapps/common/Cities Skylines II/Cities2_Data/Managed/Game.dll')">$(HOME)/.local/share/Steam/steamapps/common/Cities Skylines II</CitiesSkylines2Path>
    <CitiesSkylines2Path Condition="'$(CitiesSkylines2Path)' == '' AND Exists('$(HOME)/.steam/steam/steamapps/common/Cities Skylines II/Cities2_Data/Managed/Game.dll')">$(HOME)/.steam/steam/steamapps/common/Cities Skylines II</CitiesSkylines2Path>

    <ManagedPath>$(CitiesSkylines2Path)/Cities2_Data/Managed</ManagedPath>
  </PropertyGroup>

  <Target Name="VerifyGamePath" BeforeTargets="BeforeBuild" Condition="'$(UseCsiiToolchain)' != 'true'">
    <Error Condition="!Exists('$(ManagedPath)/Game.dll')"
           Text="Cities: Skylines II was not found. Set CSII_GAMEPATH or pass -p:CitiesSkylines2Path=&quot;&lt;game path&gt;&quot;. Expected: $(ManagedPath)/Game.dll" />
  </Target>

  <ItemGroup Condition="'$(UseCsiiToolchain)' != 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies. Mod.props supplies ManagedPath in official mode; fallback mode sets it above. -->
  <ItemGroup>
    <Reference Include="Game">
      <HintPath>$(ManagedPath)/Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Core">
      <HintPath>$(ManagedPath)/Colossal.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Logging">
      <HintPath>$(ManagedPath)/Colossal.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.IO">
      <HintPath>$(ManagedPath)/Colossal.IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.IO.AssetDatabase">
      <HintPath>$(ManagedPath)/Colossal.IO.AssetDatabase.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Localization">
      <HintPath>$(ManagedPath)/Colossal.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.UI.Binding">
      <HintPath>$(ManagedPath)/Colossal.UI.Binding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(ManagedPath)/Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <HintPath>$(ManagedPath)/Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(ManagedPath)/Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Burst">
      <HintPath>$(ManagedPath)/Unity.Burst.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
